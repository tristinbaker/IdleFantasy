<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Skill names and descriptions ===== -->

    <!-- Gathering skills -->
    <string name="skill_mining_name">采矿</string>
    <string name="skill_mining_desc">从大地中开采珍贵的矿石与宝石。</string>
    <string name="skill_fishing_name">钓鱼</string>
    <string name="skill_fishing_desc">从水域中捕获鱼类与水生珍宝。</string>
    <string name="skill_woodcutting_name">伐木</string>
    <string name="skill_woodcutting_desc">砍伐树木并收集各种木材。</string>
    <string name="skill_farming_name">农业</string>
    <string name="skill_farming_desc">在你的农田中种植和收获作物。</string>
    <string name="skill_firemaking_name">生火</string>
    <string name="skill_firemaking_desc">焚烧背包中的原木以获得生火经验值。焚烧每根原木还会产生灰烬，可在祈祷技能中撒播以获得额外的祈祷经验值。</string>
    <string name="skill_agility_name">敏捷</string>
    <string name="skill_agility_desc">训练敏捷可缩短所有技能的训练时间。99级时每小时减少%1$d分钟（60分钟→%2$d分钟），随等级提升线性递减。</string>

    <!-- Crafting skills -->
    <string name="skill_smithing_name">锻造</string>
    <string name="skill_smithing_desc">将矿石冶炼成金属锭，并锻造强大的金属装备。</string>
    <string name="skill_cooking_name">烹饪</string>
    <string name="skill_cooking_desc">将生食材烹饪为食物，在战斗中恢复生命值。</string>
    <string name="skill_fletching_name">制箭</string>
    <string name="skill_fletching_desc">用木材和金属部件制作弓箭。</string>
    <string name="skill_crafting_name">工艺制作</string>
    <string name="skill_crafting_desc">用珍贵材料制作珠宝及其他手工物品。</string>
    <string name="skill_runecrafting_name">符文制作</string>
    <string name="skill_runecrafting_desc">用符文精华制作魔法符文，用于施放法术。</string>
    <string name="skill_herblore_name">草药学</string>
    <string name="skill_herblore_desc">用种植的草药和地下城材料酿造药剂，提升你的战斗属性。</string>

    <!-- Combat skills -->
    <string name="skill_attack_name">攻击</string>
    <string name="skill_attack_desc">提高你的近战命中率，增加命中敌人的几率。</string>
    <string name="skill_strength_name">力量</string>
    <string name="skill_strength_desc">提高你的每次近战最大伤害。</string>
    <string name="skill_defense_name">防御</string>
    <string name="skill_defense_desc">减少你受到的敌人攻击伤害。</string>
    <string name="skill_ranged_name">远程</string>
    <string name="skill_ranged_desc">使用弓箭在安全距离外攻击敌人。</string>
    <string name="skill_magic_name">魔法</string>
    <string name="skill_magic_desc">使用符文施放强大的法术。更高等级可解锁更强的法术。</string>
    <string name="skill_hitpoints_name">生命值</string>
    <string name="skill_hitpoints_desc">你的总生命值。更高等级让你在战斗中存活更久。</string>
    <string name="skill_prayer_name">祈祷</string>
    <string name="skill_prayer_desc">埋葬战斗中掉落的骨头以获得祈祷经验。更高等级可解锁更强大的教堂祝福。</string>

