    <!-- ===== Agility course names and descriptions ===== -->
    <string name="agility_beginner_course_name">初级训练场</string>
    <string name="agility_beginner_course_desc">适合刚开始敏捷训练的新手的简单障碍跑道。</string>
    <string name="agility_novice_course_name">新手训练场</string>
    <string name="agility_novice_course_desc">略具挑战性的基础障碍跑道。</string>
    <string name="agility_apprentice_course_name">学徒训练场</string>
    <string name="agility_apprentice_course_desc">需要一定技巧才能通过的中级障碍跑道。</string>
    <string name="agility_intermediate_course_name">进阶训练场</string>
    <string name="agility_intermediate_course_desc">具有一定难度的复杂障碍跑道。</string>
    <string name="agility_advanced_course_name">高级训练场</string>
    <string name="agility_advanced_course_desc">考验你敏捷实力的挑战性跑道。</string>
    <string name="agility_expert_course_name">专家训练场</string>
    <string name="agility_expert_course_desc">布满危险障碍的专家级跑道。</string>
    <string name="agility_elite_course_name">精英训练场</string>
    <string name="agility_elite_course_desc">只有最敏捷的人才能征服这条精英跑道。</string>
    <string name="agility_master_course_name">大师训练场</string>
    <string name="agility_master_course_desc">充满极限障碍的大师级跑道。</string>
    <string name="agility_veteran_course_name">老兵训练场</string>
    <string name="agility_veteran_course_desc">老战士的训练场，充满严酷的挑战。</string>
    <string name="agility_champion_course_name">冠军训练场</string>
    <string name="agility_champion_course_desc">挑战你极限的冠军级跑道。</string>
    <string name="agility_heroic_course_name">英雄训练场</string>
    <string name="agility_heroic_course_desc">只有最强者才敢踏足的英雄级跑道。</string>
    <string name="agility_legendary_course_name">传奇训练场</string>
    <string name="agility_legendary_course_desc">在敏捷精英中被低声传颂的传奇跑道。</string>
    <string name="agility_mythic_course_name">神话训练场</string>
    <string name="agility_mythic_course_desc">超越物理法则的神话级跑道。</string>
    <string name="agility_divine_course_name">神域训练场</string>
    <string name="agility_divine_course_desc">受敏捷之神祝福的神圣跑道。</string>
    <string name="agility_transcendent_course_name">超越训练场</string>
    <string name="agility_transcendent_course_desc">超越凡人极限的终极敏捷考验。</string>
    <!-- Elder Isle agility courses (train elder Agility to shorten isle sessions to 45 min at 99) -->
    <string name="agility_elder_coastal_run_name">Coastal Run</string> <!-- untranslated -->
    <string name="agility_elder_coastal_run_desc">A jog along the isle\'s wave-scarred beach. Rocks shift underfoot with the tide.</string> <!-- untranslated -->
    <string name="agility_elder_grove_traverse_name">Grove Traverse</string> <!-- untranslated -->
    <string name="agility_elder_grove_traverse_desc">A rope-and-ledge circuit through the rune-lit canopy of the Ancient Forest.</string> <!-- untranslated -->
    <string name="agility_elder_volcano_scramble_name">Volcano Scramble</string> <!-- untranslated -->
    <string name="agility_elder_volcano_scramble_desc">A climb across the smoking flanks of the peak. The stone remembers being an altar.</string> <!-- untranslated -->
    <string name="agility_elder_abyssal_ascent_name">Abyssal Ascent</string> <!-- untranslated -->
    <string name="agility_elder_abyssal_ascent_desc">A vertical route up the pressure-cracked walls of the Abyssal Depths. Few make the top.</string> <!-- untranslated -->

    <!-- ===== Session skill type labels ===== -->
    <string name="skill_expedition_name">探险</string>
    <string name="skill_boss_name">首领</string>
    <string name="skill_mercantile_name">贸易</string>
    <string name="skill_mercantile_desc">派遣商队沿贸易路线出行，获取金币与经验值。技能等级越高，商店买卖价格越优，同时解锁商人公会的专属货品。</string>
</resources>
