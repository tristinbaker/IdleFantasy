    <string name="dungeon_rimewaste_name">The Rimewaste</string> <!-- untranslated -->
    <string name="dungeon_rimewaste_desc">A wind-scoured snowfield where the Frostfall\'s creatures drift down from the peaks. Part of the Frostfall event.</string> <!-- untranslated -->
    <string name="dungeon_glacier_hollows_name">The Glacier Hollows</string> <!-- untranslated -->
    <string name="dungeon_glacier_hollows_desc">Blue-lit caverns carved through the glacier, home to the Frostfall\'s fiercest beasts. Part of the Frostfall event.</string> <!-- untranslated -->
    <string name="dungeon_thornmeadow_name">The Thornmeadow</string> <!-- untranslated -->
    <string name="dungeon_thornmeadow_desc">A meadow gone wild with the spring thaw, its flowers hiding thorns and teeth. Part of the Bloomtide event.</string> <!-- untranslated -->
    <string name="dungeon_wildgrove_name">The Wildgrove</string> <!-- untranslated -->
    <string name="dungeon_wildgrove_desc">An ancient grove past the Thornmeadow where the Thorn Queen\'s court takes root. Part of the Bloomtide event.</string> <!-- untranslated -->
    <string name="boss_the_rime_wyrm_name">The Rime Wyrm</string> <!-- untranslated -->
    <string name="boss_the_rime_wyrm_desc">An ancient wyrm of living ice that wakes each Frostfall, burying the Glacier Hollows in endless winter.</string> <!-- untranslated -->
    <string name="boss_the_thorn_queen_name">The Thorn Queen</string> <!-- untranslated -->
    <string name="boss_the_thorn_queen_desc">The briar-crowned ruler of the Wildgrove, whose roses bloom each spring with thorns as long as swords.</string> <!-- untranslated -->
