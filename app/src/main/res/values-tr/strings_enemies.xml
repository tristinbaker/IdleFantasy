    <!-- Elder Isle dungeons -->
    <string name="dungeon_beach_and_cliffs_name">Beach &amp; Cliffs</string> <!-- untranslated -->
    <string name="dungeon_beach_and_cliffs_desc">The isle\'s landing zone. Coastal enemies scavenge the wrecks of prior voyages. Every clear has a chance to drop Ancient Sigils.</string> <!-- untranslated -->
    <string name="dungeon_ancient_forest_name">Ancient Forest</string> <!-- untranslated -->
    <string name="dungeon_ancient_forest_desc">A rune-laced jungle grown over an old library. Grove stalkers and rune-touched dryads keep visitors from the ruins beneath. Every clear has a chance to drop Ancient Sigils.</string> <!-- untranslated -->
    <string name="dungeon_volcano_peak_name">Volcano Peak</string> <!-- untranslated -->
    <string name="dungeon_volcano_peak_desc">The isle\'s smoking spine, once an Elder altar. Ash beasts and lava wraiths guard the sealing site. Every clear has a chance to drop Ancient Sigils.</string> <!-- untranslated -->
    <string name="dungeon_abyssal_depths_name">Abyssal Depths</string> <!-- untranslated -->
    <string name="dungeon_abyssal_depths_desc">A flooded pressure-chamber at the foot of the isle, where the Last Elder waits. Abyssal horrors and void seraphs patrol the approach. Every clear drops Ancient Sigils.</string> <!-- untranslated -->

    <!-- Elder Isle raid bosses -->
    <string name="boss_sea_serpent_name">Sea Serpent</string> <!-- untranslated -->
    <string name="boss_sea_serpent_desc">The voyage boss. A rune-scarred serpent that circles the isle and turns back everyone it doesn\'t drown. Defeat once to permanently enable Set Sail.</string> <!-- untranslated -->
    <string name="boss_last_elder_name">The Last Elder</string> <!-- untranslated -->
    <string name="boss_last_elder_desc">The last of the Elders, sealed at the bottom of the Abyssal Depths. Only a full Elder set can survive the fight.</string> <!-- untranslated -->

