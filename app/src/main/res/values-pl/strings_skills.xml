    <string name="skill_boss_name">Boss</string> <!-- untranslated -->
    <string name="skill_mercantile_name">Handel</string>
    <string name="skill_mercantile_desc">Dispatch trade caravans along routes for coins and XP. Higher levels improve shop buy and sell prices and unlock exclusive Merchants Guild goods.</string> <!-- untranslated -->
