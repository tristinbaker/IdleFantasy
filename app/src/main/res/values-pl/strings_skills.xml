    <!-- ===== Agility course names and descriptions ===== -->
    <string name="agility_beginner_course_name">Trasa dla Początkujących</string>
    <string name="agility_beginner_course_desc">Prosty tor przeszkód dla tych, którzy dopiero zaczynają trening zwinności.</string>
    <string name="agility_novice_course_name">Trasa dla Nowicjuszy</string>
    <string name="agility_novice_course_desc">Nieco trudniejsza trasa z podstawowymi przeszkodami.</string>
    <string name="agility_apprentice_course_name">Trasa dla Adeptów</string>
    <string name="agility_apprentice_course_desc">Trasa średniozaawansowana wymagająca pewnej wprawy.</string>
    <string name="agility_intermediate_course_name">Trasa Średniozaawansowana</string>
    <string name="agility_intermediate_course_desc">Umiarkowanie trudna trasa z podchwytliwymi przeszkodami.</string>
    <string name="agility_advanced_course_name">Trasa Zaawansowana</string>
    <string name="agility_advanced_course_desc">Wymagająca trasa, która sprawdza twoją biegłość w zwinności.</string>
    <string name="agility_expert_course_name">Trasa Ekspercka</string>
    <string name="agility_expert_course_desc">Trasa na poziomie eksperckim z niebezpiecznymi przeszkodami.</string>
    <string name="agility_elite_course_name">Trasa Elitarna</string>
    <string name="agility_elite_course_desc">Tylko najbardziej zwinni mogą opanować tę elitarną trasę.</string>
    <string name="agility_master_course_name">Trasa Mistrzowska</string>
    <string name="agility_master_course_desc">Trasa na poziomie mistrzowskim z ekstremalnymi przeszkodami.</string>
    <string name="agility_veteran_course_name">Trasa Weteranów</string>
    <string name="agility_veteran_course_desc">Teren treningowy weteranów z bezlitosnymi wyzwaniami.</string>
    <string name="agility_champion_course_name">Trasa Czempionów</string>
    <string name="agility_champion_course_desc">Trasa na poziomie czempiona, która wystawia cię na granicę możliwości.</string>
    <string name="agility_heroic_course_name">Trasa Heroiczna</string>
    <string name="agility_heroic_course_desc">Heroiczna trasa, na którą odważą się wejść tylko najlepsi.</string>
    <string name="agility_legendary_course_name">Trasa Legendarna</string>
    <string name="agility_legendary_course_desc">Legendarna trasa, o której szeptem mówi się wśród elity zwinności.</string>
    <string name="agility_mythic_course_name">Trasa Mityczna</string>
    <string name="agility_mythic_course_desc">Mityczna trasa łamiąca prawa fizyki.</string>
    <string name="agility_divine_course_name">Trasa Boska</string>
    <string name="agility_divine_course_desc">Boska trasa błogosławiona przez bogów zwinności.</string>
    <string name="agility_transcendent_course_name">Trasa Transcendentna</string>
    <string name="agility_transcendent_course_desc">Ostateczny sprawdzian zwinności, wykraczający poza granice śmiertelników.</string>
    <!-- Elder Isle agility courses (train elder Agility to shorten isle sessions to 45 min at 99) -->
    <string name="agility_elder_coastal_run_name">Coastal Run</string> <!-- untranslated -->
    <string name="agility_elder_coastal_run_desc">A jog along the isle\'s wave-scarred beach. Rocks shift underfoot with the tide.</string> <!-- untranslated -->
    <string name="agility_elder_grove_traverse_name">Grove Traverse</string> <!-- untranslated -->
    <string name="agility_elder_grove_traverse_desc">A rope-and-ledge circuit through the rune-lit canopy of the Ancient Forest.</string> <!-- untranslated -->
    <string name="agility_elder_volcano_scramble_name">Volcano Scramble</string> <!-- untranslated -->
    <string name="agility_elder_volcano_scramble_desc">A climb across the smoking flanks of the peak. The stone remembers being an altar.</string> <!-- untranslated -->
    <string name="agility_elder_abyssal_ascent_name">Abyssal Ascent</string> <!-- untranslated -->
    <string name="agility_elder_abyssal_ascent_desc">A vertical route up the pressure-cracked walls of the Abyssal Depths. Few make the top.</string> <!-- untranslated -->

