<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Skill names and descriptions ===== -->

    <!-- Gathering skills -->
    <string name="skill_mining_name">Górnictwo</string>
    <string name="skill_mining_desc">Wydobywaj cenne rudy i klejnoty z ziemi.</string>
    <string name="skill_fishing_name">Wędkarstwo</string>
    <string name="skill_fishing_desc">Łów ryby i wodne skarby z wód.</string>
    <string name="skill_woodcutting_name">Drwalstwo</string>
    <string name="skill_woodcutting_desc">Ścinaj drzewa i zbieraj różne rodzaje drewna.</string>
    <string name="skill_farming_name">Uprawa</string>
    <string name="skill_farming_desc">Sadź i zbieraj plony ze swoich grządek uprawnych.</string>
    <string name="skill_firemaking_name">Rozniecanie Ognia</string>
    <string name="skill_firemaking_desc">Spalaj kłody z ekwipunku, aby zdobywać XP Rozniecania Ognia. Każda spalona kłoda daje też popiół, który można rozsypać w umiejętności Modlitwy dla dodatkowego XP Modlitwy.</string>
    <string name="skill_agility_name">Zwinność</string>
    <string name="skill_agility_desc">Trenuj Zwinność, aby skrócić czas sesji we wszystkich umiejętnościach. Poziom 99 skraca godzinę o %1$d minut (60 min → %2$d min), z płynną liniową redukcją wraz ze wzrostem poziomu.</string>

    <!-- Crafting skills -->
    <string name="skill_smithing_name">Kowalstwo</string>
    <string name="skill_smithing_desc">Wytapiaj rudy w sztabki i wykuwaj potężny sprzęt metalowy.</string>
    <string name="skill_cooking_name">Gotowanie</string>
    <string name="skill_cooking_desc">Gotuj surowe składniki na jedzenie, które przywraca HP w walce.</string>
    <string name="skill_fletching_name">Łuczarstwo</string>
    <string name="skill_fletching_desc">Wytwarzaj łuki i strzały z kłód i elementów metalowych.</string>
    <string name="skill_crafting_name">Rzemiosło</string>
    <string name="skill_crafting_desc">Twórz biżuterię i inne wyroby z cennych materiałów.</string>
    <string name="skill_runecrafting_name">Tworzenie Run</string>
    <string name="skill_runecrafting_desc">Twórz magiczne runy z esencji run do wykorzystania w rzucaniu zaklęć.</string>
    <string name="skill_herblore_name">Zielarstwo</string>
    <string name="skill_herblore_desc">Warz mikstury z ziół uprawnych i składników z lochów, aby wzmocnić swoje statystyki bojowe.</string>

    <!-- Combat skills -->
    <string name="skill_attack_name">Atak</string>
    <string name="skill_attack_desc">Zwiększa twoją celność w walce wręcz, podnosząc szansę na trafienie.</string>
    <string name="skill_strength_name">Siła</string>
    <string name="skill_strength_desc">Zwiększa maksymalne obrażenia zadawane w walce wręcz na trafienie.</string>
    <string name="skill_defense_name">Obrona</string>
    <string name="skill_defense_desc">Zmniejsza obrażenia otrzymywane z ataków wrogów.</string>
    <string name="skill_ranged_name">Strzelec</string>
    <string name="skill_ranged_desc">Atakuj wrogów z bezpiecznej odległości, używając łuku i strzał.</string>
    <string name="skill_magic_name">Magia</string>
    <string name="skill_magic_desc">Rzucaj potężne zaklęcia, używając run. Wyższe poziomy odblokowują silniejsze zaklęcia.</string>
    <string name="skill_hitpoints_name">Punkty Życia</string>
    <string name="skill_hitpoints_desc">Twoje całkowite zdrowie. Wyższe poziomy pozwalają przetrwać dłużej w walce.</string>
    <string name="skill_prayer_name">Modlitwa</string>
    <string name="skill_prayer_desc">Zakopuj kości zdobyte w walce, aby zdobywać XP Modlitwy. Wyższe poziomy odblokowują potężniejsze błogosławieństwa Kościoła.</string>

