    <!-- ===== Agility course names and descriptions ===== -->
    <string name="agility_beginner_course_name">Začátečnická trať</string>
    <string name="agility_beginner_course_desc">Jednoduchá překážková dráha pro ty, kdo s tréninkem hbitosti teprve začínají.</string>
    <string name="agility_novice_course_name">Nováčkovská trať</string>
    <string name="agility_novice_course_desc">O něco náročnější trať se základními překážkami.</string>
    <string name="agility_apprentice_course_name">Učňovská trať</string>
    <string name="agility_apprentice_course_desc">Trať pro středně pokročilé, jejíž zdolání vyžaduje určitou zručnost.</string>
    <string name="agility_intermediate_course_name">Středně pokročilá trať</string>
    <string name="agility_intermediate_course_desc">Středně obtížná trať se záludnými překážkami.</string>
    <string name="agility_advanced_course_name">Pokročilá trať</string>
    <string name="agility_advanced_course_desc">Náročná trať, která prověří tvou hbitost.</string>
    <string name="agility_expert_course_name">Expertní trať</string>
    <string name="agility_expert_course_desc">Trať pro experty s nebezpečnými překážkami.</string>
    <string name="agility_elite_course_name">Elitní trať</string>
    <string name="agility_elite_course_desc">Tuto elitní trať zvládnou jen ti nejhbitější.</string>
    <string name="agility_master_course_name">Mistrovská trať</string>
    <string name="agility_master_course_desc">Mistrovská trať s extrémními překážkami.</string>
    <string name="agility_veteran_course_name">Veteránská trať</string>
    <string name="agility_veteran_course_desc">Cvičiště ostřílených veteránů s nelítostnými výzvami.</string>
    <string name="agility_champion_course_name">Šampionská trať</string>
    <string name="agility_champion_course_desc">Šampionská trať, která tě dožene až k tvým mezím.</string>
    <string name="agility_heroic_course_name">Hrdinská trať</string>
    <string name="agility_heroic_course_desc">Hrdinská trať, na kterou se odváží vstoupit jen ti nejlepší.</string>
    <string name="agility_legendary_course_name">Legendární trať</string>
    <string name="agility_legendary_course_desc">Legendární trať, o níž se mezi hbitou elitou šeptá.</string>
    <string name="agility_mythic_course_name">Mýtická trať</string>
    <string name="agility_mythic_course_desc">Mýtická trať, která se vzpírá zákonům fyziky.</string>
    <string name="agility_divine_course_name">Božská trať</string>
    <string name="agility_divine_course_desc">Božská trať požehnaná bohy hbitosti.</string>
    <string name="agility_transcendent_course_name">Transcendentní trať</string>
    <string name="agility_transcendent_course_desc">Nejvyšší zkouška hbitosti, která překračuje meze smrtelníků.</string>
    <!-- Elder Isle agility courses (train elder Agility to shorten isle sessions to 45 min at 99) -->
    <string name="agility_elder_coastal_run_name">Pobřežní běh</string>
    <string name="agility_elder_coastal_run_desc">Běh po pláži ostrova zjizvené vlnami. Kameny se pod nohama pohybují s přílivem.</string>
    <string name="agility_elder_grove_traverse_name">Přechod hájem</string>
    <string name="agility_elder_grove_traverse_desc">Okruh z lan a říms v runami ozářených korunách Prastarého lesa.</string>
    <string name="agility_elder_volcano_scramble_name">Výstup na sopku</string>
    <string name="agility_elder_volcano_scramble_desc">Šplh po dýmajících svazích vrcholu. Kámen si pamatuje, že býval oltářem.</string>
    <string name="agility_elder_abyssal_ascent_name">Propastný výstup</string>
    <string name="agility_elder_abyssal_ascent_desc">Svislá cesta vzhůru po stěnách Propastných hlubin popraskaných tlakem. Jen málokdo dosáhne vrcholu.</string>

    <!-- ===== Session skill type labels ===== -->
    <string name="skill_expedition_name">Výprava</string>
    <string name="skill_boss_name">Boss</string>
    <string name="skill_mercantile_name">Kupectví</string>
    <string name="skill_mercantile_desc">Vysílejte obchodní karavany po trasách a získávejte zlaté a XP. Vyšší úrovně zlepšují ceny při nákupu a prodeji v obchodě a odemykají exkluzivní zboží Kupeckého cechu.</string>
</resources>
