<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Skill names and descriptions ===== -->

    <!-- Gathering skills -->
    <string name="skill_mining_name">Hornictví</string>
    <string name="skill_mining_desc">Dobývej ze země cenné rudy a drahokamy.</string>
    <string name="skill_fishing_name">Rybaření</string>
    <string name="skill_fishing_desc">Lov ryby a získávej z vodních hlubin cenné poklady.</string>
    <string name="skill_woodcutting_name">Dřevorubectví</string>
    <string name="skill_woodcutting_desc">Kácej stromy a sbírej různé druhy dřeva.</string>
    <string name="skill_farming_name">Pěstování</string>
    <string name="skill_farming_desc">Sázej a sklízej plodiny na svých záhoncích.</string>
    <string name="skill_firemaking_name">Uhlířství</string>
    <string name="skill_firemaking_desc">Spaluj polena z inventáře a získávej XP z uhlířství. Z každého spáleného polena navíc vznikne popel, který můžeš v dovednosti Zbožnost rozprášit a získat tak bonusové XP zbožnosti.</string>
    <string name="skill_agility_name">Hbitost</string>
    <string name="skill_agility_desc">Trénuj hbitost, aby se zkrátila délka střetnutí ve všech dovednostech. Na 99. úrovni zkrátíš každou hodinu o %1$d minut (60 min → %2$d min); zkracování probíhá plynule a lineárně s každou dosaženou úrovní.</string>

    <!-- Crafting skills -->
    <string name="skill_smithing_name">Kovářství</string>
    <string name="skill_smithing_desc">Přetavuj rudy na ingoty a kuj mocné kovové vybavení.</string>
    <string name="skill_cooking_name">Vaření</string>
    <string name="skill_cooking_desc">Uvař ze syrových surovin jídlo, které v boji obnovuje životy.</string>
    <string name="skill_fletching_name">Dřevařství</string>
    <string name="skill_fletching_desc">Vyráběj z polen a kovových součástí luky a šípy.</string>
    <string name="skill_crafting_name">Zlatnictví</string>
    <string name="skill_crafting_desc">Vyráběj z drahých materiálů šperky a další řemeslné předměty.</string>
    <string name="skill_runecrafting_name">Runotvorba</string>
    <string name="skill_runecrafting_desc">Vyráběj z runové esence magické runy pro sesílání kouzel.</string>
    <string name="skill_herblore_name">Bylinkářství</string>
    <string name="skill_herblore_desc">Vař lektvary z bylin vypěstovaných na záhoncích a přísad získaných na výpravách, abys posílil své bojové vlastnosti.</string>

    <!-- Combat skills -->
    <string name="skill_attack_name">Útok</string>
    <string name="skill_attack_desc">Zvyšuje přesnost útoků na blízko, a tím i šanci na zásah.</string>
    <string name="skill_strength_name">Síla</string>
    <string name="skill_strength_desc">Zvyšuje maximální poškození, které můžeš způsobit jedním útokem na blízko.</string>
    <string name="skill_defense_name">Obrana</string>
    <string name="skill_defense_desc">Snižuje poškození, které utrpíš při útocích nepřátel.</string>
    <string name="skill_ranged_name">Střelba</string>
    <string name="skill_ranged_desc">Útoč na nepřátele z bezpečné vzdálenosti pomocí luku a šípů.</string>
    <string name="skill_magic_name">Kouzla</string>
    <string name="skill_magic_desc">Sesílej mocná kouzla pomocí run. Vyšší úrovně odemknou silnější kouzla.</string>
    <string name="skill_hitpoints_name">Životy</string>
    <string name="skill_hitpoints_desc">Tvé celkové zdraví. Vyšší úrovně ti umožní déle přežít v boji.</string>
    <string name="skill_prayer_name">Zbožnost</string>
    <string name="skill_prayer_desc">Pohřbíváním kostí získaných v boji získáš XP za zbožnost. Vyšší úrovně odemknou silnější požehnání Církve.</string>

