    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Jeskyně čertíků</string>
    <string name="dungeon_imp_cavern_desc">Mělká jeskyně plná zlomyslných čertíků. Ideální pro úplné začátečníky!</string>
    <string name="dungeon_goblin_cave_name">Goblinská jeskyně</string>
    <string name="dungeon_goblin_cave_desc">Temná jeskyně zamořená goblíny a obřími krysami. Dobré místo k výcviku pro nové dobrodruhy.</string>
    <string name="dungeon_spider_den_name">Pavoučí doupě</string>
    <string name="dungeon_spider_den_desc">Jeskyně plná pavučin, v níž se hemží jedovatí pavouci. Vezmi si s sebou protijed!</string>
    <string name="dungeon_bandit_camp_name">Tábor banditů</string>
    <string name="dungeon_bandit_camp_desc">Úkryt zlodějů a lotrů v divočině. Dej pozor na měšec!</string>
    <string name="dungeon_undead_crypt_name">Hrobka nemrtvých</string>
    <string name="dungeon_undead_crypt_desc">Prastaré pohřebiště, kde mrtví odmítají odpočívat. Střez se temné magie!</string>
    <string name="dungeon_fortress_ruins_name">Zřícenina pevnosti</string>
    <string name="dungeon_fortress_ruins_desc">Rozpadající se pozůstatky prastarého hradu, který nyní střeží rytíři a vojáci.</string>
    <string name="dungeon_orc_stronghold_name">Orkská pevnost</string>
    <string name="dungeon_orc_stronghold_desc">Opevněné orkské sídliště hluboko v horách. Vstoupit se odváží jen stateční.</string>
    <string name="dungeon_volcanic_depths_name">Sopečné hlubiny</string>
    <string name="dungeon_volcanic_depths_desc">Žhavá jeskyně obývaná pekelnými psy a nižšími démony. Horko je k nevydržení!</string>
    <string name="dungeon_dragon_lair_name">Dračí doupě</string>
    <string name="dungeon_dragon_lair_desc">Pověstný domov zelených draků. Tuto výzvu přežijí jen mistři válečníci.</string>
    <string name="dungeon_farm_name">Farma</string>
    <string name="dungeon_farm_desc">Poklidná farma s dobytkem. Skvělé pro začátečníky, kteří chtějí získat jídlo!</string>
    <string name="dungeon_infernal_stronghold_name">Pekelná pevnost</string>
    <string name="dungeon_infernal_stronghold_desc">Pevnost z ohně a síry, které vládnou démoni a pekelní psi. Samotné horko dokáže zabít nepřipravené.</string>
    <string name="dungeon_ancient_temple_name">Prastarý chrám</string>
    <string name="dungeon_ancient_temple_desc">Prastarý chrám střežený nejmocnějšími tvory v říši. Vstoupit se odváží jen ti nejsilnější válečníci.</string>
    <string name="dungeon_void_rift_name">Trhlina prázdnoty</string>
    <string name="dungeon_void_rift_desc">Trhlina v realitě, kterou do světa smrtelníků proudí tvorové z prázdnoty.</string>
    <string name="dungeon_frozen_citadel_name">Zmrzlá citadela</string>
    <string name="dungeon_frozen_citadel_desc">Prastará pevnost zamrzlá v ledovci, jejíž obránci strnuli ve věčné hlídce.</string>
    <string name="dungeon_abyssal_throne_name">Propastný trůn</string>
    <string name="dungeon_abyssal_throne_desc">Nejhlubší místo známého světa, kterému od úsvitu věků vládnou páni prázdnoty.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">Sluneční věž</string>
    <string name="dungeon_sunspire_desc">Zřícenina sluneční věže, kterou slunovrat roztříštil a vypustil do kraje duchy žáru. Součást události Slunovrat Sluneční věže.</string>
    <string name="dungeon_hollowfen_name">Dutá slať</string>
    <string name="dungeon_hollowfen_desc">Mlhou zatopená slať potopených mohyl, kde chodí mrtví sklizně. Součást události Chmurná sklizeň.</string>
    <string name="dungeon_cloud_kingdom_name">Oblačné království</string>
    <string name="dungeon_cloud_kingdom_desc">Říše nad oblaky, do které se dostaneš po legendárním fazolovém stonku. Po rozlehlých vznášejících se ostrovech se toulají obři, mezi oblačnými valy plují nebeští hadi a bouřní čertíci praskají neklidnou energií. Jen málokdo ji spatřil. A ještě méně jich se vrátilo, aby o ní vyprávělo.</string>
    <string name="dungeon_blightwood_name">Zhoubný les</string>
    <string name="dungeon_blightwood_desc">Hnijící les hluboko za Dutou slatí, kde se shromažďují nejstrašlivější hrůzy Chmurné sklizně. Součást události Chmurná sklizeň.</string>

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Černý dračí král</string>
    <string name="boss_king_black_dragon_desc">Legendární tříhlavý drak, jehož se bojí celá říše.</string>
    <string name="boss_demon_lord_name">Pán démonů</string>
    <string name="boss_demon_lord_desc">Prastarý démon z propasti, mistr temné magie.</string>
    <string name="boss_kraken_name">Kraken</string>
    <string name="boss_kraken_desc">Postrach hlubokých moří, obří mořská příšera.</string>
    <string name="boss_balrog_name">Žár temnoty</string>
    <string name="boss_balrog_desc">Prastarý démon plamene a stínu, probuzený ze spánku hluboko pod zemí.</string>
    <string name="boss_void_sovereign_name">Vládce prázdnoty</string>
    <string name="boss_void_sovereign_desc">Prapůvodní bytost stojící za trhlinami prázdnoty. Je prastará nad všechno chápání a smrtelné vyzyvatele sleduje s pohrdáním.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, Roztříštěný plamen</string>
    <string name="boss_sol_invictus_desc">Úlomek samotného slunce, utržený ze zříceniny Sluneční věže. Přiblížit se k němu odváží jen ti nejodvážnější bojovníci.</string>
    <string name="boss_the_hollow_king_name">Dutý král</string>
    <string name="boss_the_hollow_king_desc">Bezhlavý vladař Chmurné sklizně, který vyjíždí ze Zhoubného lesa, aby sklidil, co živí zaseli.</string>
    <string name="boss_the_vault_guardian_name">Strážce pokladnice</string>
    <string name="boss_the_vault_guardian_desc">Kolos ze živého zlata, probuzený rozžehnutím Věčného plamene. Postavit se mu mohou jen mecenáši Velkého monumentu.</string>
    <string name="boss_obsidian_colossus_name">Obsidiánový kolos</string>
    <string name="boss_obsidian_colossus_desc">Hora obdařená hněvem. Žádný osamělý hrdina do ní nevyrazil víc než škrábanec. Přiveď družinu.</string>
    <string name="boss_brood_empress_name">Císařovna roje</string>
    <string name="boss_brood_empress_desc">Matka roje mezi hvězdami. Její plod pohubil celá vojska; tvá družina ať je raději dobře placená.</string>
    <string name="boss_the_world_ender_name">Ničitel světů</string>
    <string name="boss_the_world_ender_desc">Když se probudí, království sepisují závěti. Na smlouvě musí stát čtyři jména, jinak se nevrátí nikdo.</string>

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Zřícený důl</string>
    <string name="dungeon_collapsed_mine_desc">Rozlehlá jeskyně pod měděnými doly. V sutinách straší jeskynní trollové a skalní golemové a obří pavouci spřádají sítě přes zřícené štoly.</string>
    <string name="dungeon_shadow_den_name">Stínové doupě</string>
    <string name="dungeon_shadow_den_desc">Spleť podzemních komnat, které využívá zlodějský cech kraje. V každém koutě číhají lotři, vrazi a stínoví tvorové.</string>
    <string name="dungeon_abyssal_ruins_name">Propastné zříceniny</string>
    <string name="dungeon_abyssal_ruins_desc">Prastaré zříceniny, které existují současně nad rovinou smrtelníků i pod ní. Podivní tvorové z propasti se zjevují a mizí z reality.</string>
    <string name="dungeon_ancient_forest_ruins_name">Zříceniny v Prastarém lese</string>
    <string name="dungeon_ancient_forest_ruins_desc">Kamenné zříceniny pohlcené pralesem, v nichž dnes straší divocí tvorové a mstiví duchové druidů.</string>
    <string name="dungeon_ancient_forge_name">Prastará kovárna</string>
    <string name="dungeon_ancient_forge_desc">Rozlehlá trpasličí kovárna, která hoří bez ustání už celá staletí. Její tajemství chrání ohniví elementálové a strážci kovárny.</string>
    <string name="dungeon_arcane_ruins_name">Tajemné zříceniny</string>
    <string name="dungeon_arcane_ruins_desc">Zachovalé podzemní komnaty zničené čarodějovy věže. Jejími sály stále hlídkují magické konstrukty a očarovaní strážci.</string>
    <string name="dungeon_corrupted_sanctum_name">Zkažená svatyně</string>
    <string name="dungeon_corrupted_sanctum_desc">Stínem prosycená svatyně v srdci zkažených korun stromů. Temní kněží a zkažené bestie střeží prastaré zlo.</string>
    <string name="dungeon_drowned_temple_name">Utopený chrám</string>
    <string name="dungeon_drowned_temple_desc">Potopený chrám pod mořskou jeskyní. V jeho zatopených sálech sídlí mořští tvorové, kteří si z něj udělali domov.</string>
    <string name="dungeon_rogue_sanctum_name">Útočiště lotrů</string>
    <string name="dungeon_rogue_sanctum_desc">Vnitřní útočiště cechu, přístupné jen osvědčeným členům.</string>
    <string name="dungeon_guild_of_shadows_name">Cech stínů</string>
    <string name="dungeon_guild_of_shadows_desc">Nejvnitřnější svatyně zlodějského cechu, kterou střeží jeho nejlepší vymahači.</string>

