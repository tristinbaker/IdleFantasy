    <!-- Elder Isle dungeons -->
    <string name="dungeon_beach_and_cliffs_name">Pláž a útesy</string>
    <string name="dungeon_beach_and_cliffs_desc">Místo vylodění na ostrově. Pobřežní nepřátelé se živí vraky předchozích plaveb. Při každém zdolání mohou padnout Prastaré pečeti.</string>
    <string name="dungeon_ancient_forest_name">Prastarý les</string>
    <string name="dungeon_ancient_forest_desc">Runami protkaná džungle, která zarostla starou knihovnu. Hájoví stopaři a runami dotčené dryády brání návštěvníkům ve vstupu do zřícenin pod ní. Při každém zdolání mohou padnout Prastaré pečeti.</string>
    <string name="dungeon_volcano_peak_name">Sopečný vrchol</string>
    <string name="dungeon_volcano_peak_desc">Dýmající hřbet ostrova, kdysi oltář Pradávných. Popelavé bestie a lávové přízraky hlídají místo zpečetění. Při každém zdolání mohou padnout Prastaré pečeti.</string>
    <string name="dungeon_abyssal_depths_name">Propastné hlubiny</string>
    <string name="dungeon_abyssal_depths_desc">Zatopená tlaková komora na úpatí ostrova, kde čeká Poslední Pradávný. Přístup hlídkují propastné hrůzy a serafové prázdnoty. Při každém zdolání padají Prastaré pečeti.</string>

    <!-- Elder Isle raid bosses -->
    <string name="boss_sea_serpent_name">Mořský had</string>
    <string name="boss_sea_serpent_desc">Boss plavby. Runami zjizvený had, který krouží kolem ostrova a každého, koho neutopí, obrátí zpět. Jeho jednorázovým poražením se trvale odemkne Vyplutí.</string>
    <string name="boss_last_elder_name">Poslední Pradávný</string>
    <string name="boss_last_elder_desc">Poslední z Pradávných, zapečetěný na dně Propastných hlubin. Souboj přežije jen ten, kdo má plnou pradávnou sadu.</string>

    <!-- Frostfall and Bloomtide -->
    <string name="enemy_frost_sprite_name">Mrazivý skřítek</string>
    <string name="enemy_snow_wolf_name">Sněžný vlk</string>
    <string name="enemy_ice_troll_name">Ledový troll</string>
    <string name="enemy_rime_revenant_name">Námrazový revenant</string>
    <string name="enemy_glacier_yeti_name">Ledovcový yeti</string>
    <string name="enemy_rime_giant_name">Námrazový obr</string>
    <string name="enemy_frostbound_jarl_name">Mrazem spoutaný jarl</string>
    <string name="enemy_pollen_sprite_name">Pylový skřítek</string>
    <string name="enemy_bramble_boar_name">Trnitý kanec</string>
    <string name="enemy_briar_beast_name">Šípková bestie</string>
    <string name="enemy_verdant_drake_name">Smaragdový drak</string>
    <string name="enemy_thorn_stalker_name">Trnový stopař</string>
    <string name="enemy_blossom_treant_name">Kvetoucí treant</string>
    <string name="enemy_bramble_titan_name">Trnitý titán</string>
    <string name="dungeon_rimewaste_name">Námrazová pustina</string>
    <string name="dungeon_rimewaste_desc">Větrem ošlehané sněžné pláně, kam z hor sestupují tvorové Mrazopádu. Součást události Mrazopád.</string>
    <string name="dungeon_glacier_hollows_name">Ledovcové dutiny</string>
    <string name="dungeon_glacier_hollows_desc">Modře osvětlené jeskyně prorubané ledovcem, domov nejdivočejších bestií Mrazopádu. Součást události Mrazopád.</string>
    <string name="dungeon_thornmeadow_name">Trnitá louka</string>
    <string name="dungeon_thornmeadow_desc">Louka, která s jarním táním zdivočela; její květy ukrývají trny i zuby. Součást události Rozkvět.</string>
    <string name="dungeon_wildgrove_name">Divoký háj</string>
    <string name="dungeon_wildgrove_desc">Prastarý háj za Trnitou loukou, kde zakořenil dvůr Trnové královny. Součást události Rozkvět.</string>
    <string name="boss_the_rime_wyrm_name">Námrazový wyrm</string>
    <string name="boss_the_rime_wyrm_desc">Prastarý wyrm ze živého ledu, který se probouzí každý Mrazopád a pohřbívá Ledovcové dutiny pod nekonečnou zimou.</string>
    <string name="boss_the_thorn_queen_name">Trnová královna</string>
    <string name="boss_the_thorn_queen_desc">Vládkyně Divokého háje s korunou ze šípkového trní, jejíž růže každé jaro rozkvétají s trny dlouhými jako meče.</string>
</resources>
