    <!-- ===== Agility course names and descriptions ===== -->
    <string name="agility_beginner_course_name">Percorso per Principianti</string>
    <string name="agility_beginner_course_desc">Un percorso a ostacoli semplice per chi vuole iniziare ad addestrare la propria agilità.</string>
    <string name="agility_novice_course_name">Percorso per Novizi</string>
    <string name="agility_novice_course_desc">Un percorso leggermente più impegnativo con ostacoli semplici.</string>
    <string name="agility_apprentice_course_name">Percorso per Apprendisti</string>
    <string name="agility_apprentice_course_desc">Un percorso intermedio che richiede una certa destrezza.</string>
    <string name="agility_intermediate_course_name">Percorso Intermedio</string>
    <string name="agility_intermediate_course_desc">Un percorso moderatamente difficile con ostacoli insidiosi.</string>
    <string name="agility_advanced_course_name">Percorso Avanzato</string>
    <string name="agility_advanced_course_desc">Un percorso stimolante che mete alla prova la tua agilità.</string>
    <string name="agility_expert_course_name">Percorso per Esperti</string>
    <string name="agility_expert_course_desc">Un percorso per esperti con ostacoli pericolosi.</string>
    <string name="agility_elite_course_name">Percorso per Elite</string>
    <string name="agility_elite_course_desc">Solo i più agili sono in grado di padroneggiare questo percorso per elite.</string>
    <string name="agility_master_course_name">Percorso per Maestri</string>
    <string name="agility_master_course_desc">Un percorso per maestri con ostacoli estremi.</string>
    <string name="agility_veteran_course_name">Percorso per Veterani</string>
    <string name="agility_veteran_course_desc">Il campo di addestramento di un veterano, con sfide punitive.</string>
    <string name="agility_champion_course_name">Percorso per Campioni</string>
    <string name="agility_champion_course_desc">Un percorso per campioni che ti spingerà oltre i tuoi limiti.</string>
    <string name="agility_heroic_course_name">Percorso per Eroi</string>
    <string name="agility_heroic_course_desc">Un percorso per eroi dove solo i migliori osano avventurarsi.</string>
    <string name="agility_legendary_course_name">Percorso Leggendario</string>
    <string name="agility_legendary_course_desc">Un percorso leggendario del quale la migliore elite parla sotto voce.</string>
    <string name="agility_mythic_course_name">Percorso Mitico</string>
    <string name="agility_mythic_course_desc">Un percorso mitico che sfida le leggi della fisica.</string>
    <string name="agility_divine_course_name">Percorso Divino</string>
    <string name="agility_divine_course_desc">Un percorso divino graziato dagli dei dell\'agilità.</string>
    <string name="agility_transcendent_course_name">Percorso Trascendentale</string>
    <string name="agility_transcendent_course_desc">La prova finale dell\'agilità, trascende i limiti dei mortali.</string>
    <!-- Elder Isle agility courses (train elder Agility to shorten isle sessions to 45 min at 99) -->
    <string name="agility_elder_coastal_run_name">Corsa sulla Costa</string>
    <string name="agility_elder_coastal_run_desc">Un giro intorno la spiaggia dell\'isola. Le rocce si spostano con i movimenti delle maree.</string>
    <string name="agility_elder_grove_traverse_name">Cammino Boschivo</string>
    <string name="agility_elder_grove_traverse_desc">Percorso attraverso gli alberi dell\'Antica Foresta, preparati ad affrontare molte arrampicate!</string>
    <string name="agility_elder_volcano_scramble_name">Arrampicata Vulcanica</string>
    <string name="agility_elder_volcano_scramble_desc">Scala i versanti fumanti del vulcano.</string>
    <string name="agility_elder_abyssal_ascent_name">Ascesa dall\'Abisso</string>
    <string name="agility_elder_abyssal_ascent_desc">Un percorso verticale contro la pressione abissale.</string>

    <!-- ===== Session skill type labels ===== -->
    <string name="skill_expedition_name">Spedizione</string>
    <string name="skill_boss_name">Boss</string>
    <string name="skill_mercantile_name">Mercantile</string>
    <string name="skill_mercantile_desc">Spedisci carovane di mercanti verso rotte commerciali per monete e XP. Rotte migliori portano a sconti e offerte nell\'emporio, insieme a oggetti unici.</string>
</resources>
