<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Skill names and descriptions ===== -->

    <!-- Gathering skills -->
    <string name="skill_mining_name">Estrazione</string>
    <string name="skill_mining_desc">Estrai minerali preziosi e gemme dalla terra.</string>
    <string name="skill_fishing_name">Pesca</string>
    <string name="skill_fishing_desc">Cattura pesci e tesori marini.</string>
    <string name="skill_woodcutting_name">Taglialegna</string>
    <string name="skill_woodcutting_desc">Taglia alberi e raccogli vari tipi di legno.</string>
    <string name="skill_farming_name">Agricoltura</string>
    <string name="skill_farming_desc">Semina e raccogli frutta e ortaggi dai tuoi campi.</string>
    <string name="skill_firemaking_name">Fuochista</string>
    <string name="skill_firemaking_desc">Brucia legno dal tuo deposito. Ciascun legno produce anche cenere, utile come catalizzatore o durante la Preghiera.</string>
    <string name="skill_agility_name">Agilità</string>
    <string name="skill_agility_desc">Addestra la tua Agilità per ridurre la durata delle sessioni di addestramento. Il livello 99 riduce di 20 minuti la durata (60 min → 40 min), con una riduzione lineare in base al livello.</string>

    <!-- Crafting skills -->
    <string name="skill_smithing_name">Fabbro</string>
    <string name="skill_smithing_desc">Fondi lingotti di metallo dai minerali grezzi e forgia potenti equipaggiamenti.</string>
    <string name="skill_cooking_name">Cucina</string>
    <string name="skill_cooking_desc">Prepara deliziosi manicaretti da ingredienti freschi, in grado di farti recuperare PS in battaglia.</string>
    <string name="skill_fletching_name">Frecciaio</string>
    <string name="skill_fletching_desc">Costruisci frecce, armi in legno e altri componenti.</string>
    <string name="skill_crafting_name">Oreficeria</string>
    <string name="skill_crafting_desc">Crea gioielli da metalli preziosi.</string>
    <string name="skill_runecrafting_name">Incisione di Rune</string>
    <string name="skill_runecrafting_desc">Incidi rune a partire dalla loro essenza per lanciare incantesimi.</string>
    <string name="skill_herblore_name">Erboristeria</string>
    <string name="skill_herblore_desc">Crea pozioni dal raccolto dei tuoi campi in grado di migliorare le tue doti in battaglia.</string>

    <!-- Combat skills -->
    <string name="skill_attack_name">Attacco da Mischia</string>
    <string name="skill_attack_desc">Migliora la tua precisione in attacchi corpo a corpo, aumentando la tua probabilità di colpire.</string>
    <string name="skill_strength_name">Forza</string>
    <string name="skill_strength_desc">Aumenta il tuo danno massimo per colpo.</string>
    <string name="skill_defense_name">Difesa</string>
    <string name="skill_defense_desc">Riduce il danno ricevuto dagli attacchi dei nemici.</string>
    <string name="skill_ranged_name">Attacco a Distanza</string>
    <string name="skill_ranged_desc">Attacca nemici da una distanza sicura usando arco e frecce.</string>
    <string name="skill_magic_name">Magia</string>
    <string name="skill_magic_desc">Lancia potenti incantesimi usando rune. Livelli più alti sbloccano incantesimi più forti.</string>
    <string name="skill_hitpoints_name">Salute</string>
    <string name="skill_hitpoints_desc">La tua energia massima. Livelli più alti ti permettono di sopravvivere più a lungo in combattimento.</string>
    <string name="skill_prayer_name">Preghiera</string>
    <string name="skill_prayer_desc">Seppellisci le ossa raccolte in combattimento per guadagnare XP. Livelli più alti sbloccano benedizioni della Chiesa più potenti.</string>

