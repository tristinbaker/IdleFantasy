    <string name="skill_agility_name">Agility</string> <!-- untranslated -->
    <string name="skill_agility_desc">Train Agility to reduce session times across all skills. Level 99 cuts 20 minutes off the hour (60 min → 40 min), with a smooth linear reduction as you level up.</string> <!-- untranslated -->

