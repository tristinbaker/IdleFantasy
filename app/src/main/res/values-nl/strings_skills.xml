<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Skill names and descriptions ===== -->

    <!-- Gathering skills -->
    <string name="skill_mining_name">Mijnen</string>
    <string name="skill_mining_desc">Win waardevolle ertsen en edelstenen uit de aarde.</string>
    <string name="skill_fishing_name">Vissen</string>
    <string name="skill_fishing_desc">Vang vissen en aquatische schatten uit het water.</string>
    <string name="skill_woodcutting_name">Houthakken</string>
    <string name="skill_woodcutting_desc">Hak bomen om verschillende soorten hout te verzamelen.</string>
    <string name="skill_farming_name">Landbouw</string>
    <string name="skill_farming_desc">Plant en oogst gewassen van je landbouwpercelen.</string>
    <string name="skill_firemaking_name">Vuurmaken</string>
    <string name="skill_firemaking_desc">Verbrand houtblokken uit je inventaris om Vuurmaken XP te verdienen. Elk verbrand houtblok produceert ook as, die kan worden verstrooid in de Gebed vaardigheid voor bonus Gebed XP.</string>
    <string name="skill_agility_name">Behendigheid</string>
    <string name="skill_agility_desc">Train Behendigheid om sessietijden voor alle vaardigheden te verkorten. Level 99 vermindert %1$d minuten van het uur (60 min → %2$d min), met een vloeiende lineaire vermindering naarmate je hogere levels bereikt.</string>

    <!-- Crafting skills -->
    <string name="skill_smithing_name">Smeden</string>
    <string name="skill_smithing_desc">Smelt ertsen tot staven en smeed krachtige metalen uitrusting.</string>
    <string name="skill_cooking_name">Koken</string>
    <string name="skill_cooking_desc">Kook rauwe ingrediënten tot voedsel dat HP herstelt in gevechten.</string>
    <string name="skill_fletching_name">Pijlen</string>
    <string name="skill_fletching_desc">Maak bogen en pijlen van houtblokken en metalen onderdelen.</string>
    <string name="skill_crafting_name">Juwerlier</string>
    <string name="skill_crafting_desc">Maak sieraden en andere ambachtelijke voorwerpen van waardevolle materialen.</string>
    <string name="skill_runecrafting_name">Runen</string>
    <string name="skill_runecrafting_desc">Maak magische runen van runenessentie voor gebruik in spreuken.</string>
    <string name="skill_herblore_name">Toverdranken</string>
    <string name="skill_herblore_desc">Brouw drankjes van landbouwkruiden en kerkeringrediënten om je gevechtsstatistieken te verbeteren.</string>

    <!-- Combat skills -->
    <string name="skill_attack_name">Aanval</string>
    <string name="skill_attack_desc">Verbetert je nauwkeurigheid in mêlee-gevechten, waardoor je kans om te raken toeneemt.</string>
    <string name="skill_strength_name">Kracht</string>
    <string name="skill_strength_desc">Verhoogt je maximale mêlee-schade per slag.</string>
    <string name="skill_defense_name">Verdediging</string>
    <string name="skill_defense_desc">Vermindert de schade die je oploopt van vijandelijke aanvallen.</string>
    <string name="skill_ranged_name">Boogschutterij</string>
    <string name="skill_ranged_desc">Val vijanden aan van een veilige afstand met een boog en pijlen.</string>
    <string name="skill_magic_name">Magie</string>
    <string name="skill_magic_desc">Gebruik krachtige spreuken met runen. Hogere levels ontgrendelen sterkere spreuken.</string>
    <string name="skill_hitpoints_name">Hitpoints</string> <!-- untranslated -->
    <string name="skill_hitpoints_desc">Je totale gezondheid. Hogere levels laten je langer overleven in gevechten.</string>
    <string name="skill_prayer_name">Gebed</string>
    <string name="skill_prayer_desc">Begraaf botten die vallen bij gevechten om Gebed XP te verdienen. Hogere levels ontgrendelen sterkere zegeningen van de Kerk.</string>

