    <!-- ===== Agility course names and descriptions ===== -->
    <string name="agility_beginner_course_name">Beginners Parcours</string>
    <string name="agility_beginner_course_desc">Een eenvoudige hindernisbaan voor degenen die net beginnen met hun behendigheidstraining.</string>
    <string name="agility_novice_course_name">Novice Parcours</string>
    <string name="agility_novice_course_desc">Een iets uitdagendere baan met basisobstakels.</string>
    <string name="agility_apprentice_course_name">Leerling Parcours</string>
    <string name="agility_apprentice_course_desc">Een baan voor degenen die enige vaardigheid nodig hebben om te navigeren.</string>
    <string name="agility_intermediate_course_name">Intermediate Parcours</string>
    <string name="agility_intermediate_course_desc">Een matig moeilijke baan met lastige obstakels.</string>
    <string name="agility_advanced_course_name">Geavanceerde Parcours</string>
    <string name="agility_advanced_course_desc">Een uitdagende baan die je behendigheid op de proef stelt.</string>
    <string name="agility_expert_course_name">Expert Parcours</string>
    <string name="agility_expert_course_desc">Een baan op expert-niveau met gevaarlijke obstakels.</string>
    <string name="agility_elite_course_name">Elite Parcours</string>
    <string name="agility_elite_course_desc">Alleen de meest behendige kunnen deze elitebaan beheersen.</string>
    <string name="agility_master_course_name">Meester Parcours</string>
    <string name="agility_master_course_desc">Een baan op meester-niveau met extreme obstakels.</string>
    <string name="agility_veteran_course_name">Veteranen Parcours</string>
    <string name="agility_veteran_course_desc">Een trainingsgrond voor veteranen met straffende uitdagingen.</string>
    <string name="agility_champion_course_name">Kampioen Parcours</string>
    <string name="agility_champion_course_desc">Een baan op kampioensniveau die je tot het uiterste drijft.</string>
    <string name="agility_heroic_course_name">Heroïsch Parcours</string>
    <string name="agility_heroic_course_desc">Een heroïsche baan waar alleen de besten durven te betreden.</string>
    <string name="agility_legendary_course_name">Legendarisch Parcours</string>
    <string name="agility_legendary_course_desc">Een legendarische baan waarover gefluisterd wordt onder de behendige elite.</string>
    <string name="agility_mythic_course_name">Mythisch Parcours</string>
    <string name="agility_mythic_course_desc">Een mythische baan die de wetten van de fysica tart.</string>
    <string name="agility_divine_course_name">Goddelijk Parcours</string>
    <string name="agility_divine_course_desc">Een goddelijke baan gezegend door de goden van behendigheid.</string>
    <string name="agility_transcendent_course_name">Transcendent Parcours</string>
    <string name="agility_transcendent_course_desc">De ultieme test van behendigheid, die de grenzen van sterfelijke vermogens overstijgt.</string>
    <!-- Elder Isle agility courses (train elder Agility to shorten isle sessions to 45 min at 99) -->
    <string name="agility_elder_coastal_run_name">Coastal Run</string> <!-- untranslated -->
    <string name="agility_elder_coastal_run_desc">A jog along the isle\'s wave-scarred beach. Rocks shift underfoot with the tide.</string> <!-- untranslated -->
    <string name="agility_elder_grove_traverse_name">Grove Traverse</string> <!-- untranslated -->
    <string name="agility_elder_grove_traverse_desc">A rope-and-ledge circuit through the rune-lit canopy of the Ancient Forest.</string> <!-- untranslated -->
    <string name="agility_elder_volcano_scramble_name">Volcano Scramble</string> <!-- untranslated -->
    <string name="agility_elder_volcano_scramble_desc">A climb across the smoking flanks of the peak. The stone remembers being an altar.</string> <!-- untranslated -->
    <string name="agility_elder_abyssal_ascent_name">Abyssal Ascent</string> <!-- untranslated -->
    <string name="agility_elder_abyssal_ascent_desc">A vertical route up the pressure-cracked walls of the Abyssal Depths. Few make the top.</string> <!-- untranslated -->

    <!-- ===== Session skill type labels ===== -->
    <string name="skill_expedition_name">Expeditie</string>
    <string name="skill_boss_name">Baas</string>
    <string name="skill_mercantile_name">Koophandel</string>
    <string name="skill_mercantile_desc">Dispatch trade caravans along routes for coins and XP. Higher levels improve shop buy and sell prices and unlock exclusive Merchants Guild goods.</string> <!-- untranslated -->
